{
    "name": "icspark-webdev-env",
    "image": "node:18-alpine",
    "forwardPorts": [3000, 3001],
    "features": {
        "ghcr.io/devcontainers/features/git:1": {}
    },
    "customizations": {
      "vscode": {
        "extensions": [
          "ms-vscode.live-server"
        ]
      }
    },
    "portsAttributes": {
      "3000": {
        "label": "Live Server"
      },
      "3001": {
        "label": "IGNORE ME"
      }
    },
    "postAttachCommand": ". .devcontainer/welcome.sh"
  }
